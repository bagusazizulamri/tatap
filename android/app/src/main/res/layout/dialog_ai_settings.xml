<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🤖 PENGATURAN AI TRANSLATE"
            android:textColor="#00DBEB"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btn_close_ai_dialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="✕"
            android:textColor="#8892B0"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Current Status Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_command_banner"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_ai_status_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="API Key : (Belum disetel)"
                    android:textColor="#00DBEB"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tv_ai_status_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Model   : gemini-3.1-flash-lite"
                    android:textColor="#E1E7EF"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tv_ai_status_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="API URL : https://generativelanguage.googleapis.com..."
                    android:textColor="#8892B0"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:ellipsize="middle" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Preset Provider AI Cepat:"
                android:textColor="#8892B0"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="6dp" />

            <!-- Preset Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btn_preset_gemini"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:text="💎 Google Gemini"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#16202E"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/btn_preset_groq"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:text="⚡ Groq (Llama-3.3)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#16202E"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_preset_ollama"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:text="🦙 Ollama Cloud"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#16202E"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/btn_preset_openai"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:text="🧠 OpenAI"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#16202E"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- API Key Input Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API Key:"
                android:textColor="#8892B0"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="3dp" />

            <EditText
                android:id="@+id/et_ai_apikey"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_input_field"
                android:hint="Tempel API key (misal AQ... atau gsk_...)"
                android:textColorHint="#5A6578"
                android:textColor="#E1E7EF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="10dp"
                android:inputType="textPassword"
                android:layout_marginBottom="10dp" />

            <!-- Model Input Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Model LLM (Opsional):"
                android:textColor="#8892B0"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="3dp" />

            <EditText
                android:id="@+id/et_ai_model"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_input_field"
                android:hint="gemini-3.1-flash-lite"
                android:textColorHint="#5A6578"
                android:textColor="#E1E7EF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:layout_marginBottom="10dp" />

            <!-- API URL Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Endpoint API URL (Opsional):"
                android:textColor="#8892B0"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="3dp" />

            <EditText
                android:id="@+id/et_ai_apiurl"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_input_field"
                android:hint="https://generativelanguage.googleapis.com/v1beta/openai"
                android:textColorHint="#5A6578"
                android:textColor="#E1E7EF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:layout_marginBottom="14dp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/btn_ai_view_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="📜 Log"
                    android:textColor="#8892B0"
                    android:backgroundTint="#161A24"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_ai_reset_key"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Hapus Key"
                    android:textColor="#EF4444"
                    android:backgroundTint="#161A24"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_ai_save"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Simpan"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0E7490"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
