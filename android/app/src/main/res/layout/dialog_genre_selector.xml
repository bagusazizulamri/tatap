<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pilih Genre Anime"
            android:textColor="#F1F5F9"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_close_genre_dialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="✕"
            android:textColor="#8892B0"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Search/Filter Input -->
    <EditText
        android:id="@+id/et_filter_genre"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_input_field"
        android:hint="Cari genre (misal: Action, Romance)..."
        android:textColorHint="#5A6578"
        android:textColor="#F1F5F9"
        android:textSize="13sp"
        android:paddingHorizontal="12dp"
        android:singleLine="true" />

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/pb_genre_loading"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:layout_marginVertical="16dp"
        android:indeterminateTint="#38BDF8" />

    <!-- Genre Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_genres"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- Action Bar (Reset filter & Tutup) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end">

        <Button
            android:id="@+id/btn_reset_genre_filter"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Hapus Filter"
            android:textColor="#EF4444"
            android:backgroundTint="#161A24"
            android:textSize="11.5sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_dismiss_genre"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Tutup"
            android:textColor="#8892B0"
            android:backgroundTint="#161A24"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
