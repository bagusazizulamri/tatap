<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#10141F"
    app:strokeColor="#1E273A"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Poster with Overlay Badges and Bottom Gradient Scrim -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:background="#151A26">

            <ImageView
                android:id="@+id/iv_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <!-- Bottom Gradient Scrim for Smooth Transition -->
            <View
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_poster_scrim" />

            <!-- Top Left: Format/Type Badge (TV, Movie, ONA) -->
            <TextView
                android:id="@+id/tv_badge_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="7dp"
                android:background="@drawable/bg_badge_type"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="TV"
                android:textColor="#E2E8F0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <!-- Top Right: Score Badge (★ 8.5) -->
            <TextView
                android:id="@+id/tv_badge_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="7dp"
                android:background="@drawable/bg_badge_score"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="★ 8.5"
                android:textColor="#FBBF24"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:visibility="gone" />

            <!-- Bottom Left: Subtitle Status / Episode Badge -->
            <TextView
                android:id="@+id/tv_badge_ep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="7dp"
                android:background="@drawable/bg_badge_sub"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:text="SUB ID"
                android:textColor="#00DBEB"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </FrameLayout>

        <!-- Card Title & Metadata Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:background="#10141F">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Judul Anime"
                android:textColor="#F8FAFC"
                android:textSize="12sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="12 Episode"
                    android:textColor="#828FA3"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
